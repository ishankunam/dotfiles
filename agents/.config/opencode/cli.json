{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide",
    "markdown": "rendered",
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "mode": "off",
    "layout": "horizontal",
    "scope": "cwd",
    "indicators": "status"
  },
  "terminal": {
    "copy": "select"
  }
}
