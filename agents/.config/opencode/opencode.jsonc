{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ],
  "plugins": ["-opencode.provider.openai-context-caps"],
  "formatter": {
    "ruff": {
      "command": ["sh", "-c", "ruff check --fix \"$1\"; ruff format \"$1\"", "sh", "$FILE"]
    },
    "biome": { "disabled": true },
    "bun-js": {
      "command": ["sh", "-c", "biome lint --write \"$1\"; bun fmt --no-script \"$1\"", "sh", "$FILE"],
      "extensions": [".js", ".jsx", ".mjs", ".cjs", ".ts", ".tsx", ".mts", ".cts"]
    },
    "bun-other": {
      "command": ["bun", "fmt", "--no-script", "$FILE"],
      "extensions": [".css", ".html", ".json", ".jsonc", ".yaml", ".yml", ".md"]
    }
  },
  "providers": {
    "openai": {
      "models": {
        "gpt-6.2-astra": { "limit": { "context": 872000, "output": 128000 } },
        "gpt-6.2-sol": { "limit": { "context": 872000, "output": 128000 } },
        "gpt-6.1-terra": { "limit": { "context": 872000, "output": 128000 } },
        "gpt-6.1-sol": { "limit": { "context": 872000, "output": 128000 } },
        "gpt-6-astra": { "limit": { "context": 872000, "output": 128000 } },
        "gpt-6-sol": { "limit": { "context": 872000, "output": 128000 } },
        "gpt-6-luna": { "limit": { "context": 872000, "output": 128000 } }
      }
    }
  },
  "mcp": {
    "servers": {
      "parallel-mcp": {
        "type": "remote",
        "url": "https://mcp.parallel.ai/mcp?login"
      }
    }
  }
}
