{
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Bash(git merge *)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(gh pr merge *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * master)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:master)",
      "Bash(git push * HEAD:main)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)"
    ]
  },
  "model": "sonnet",
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": true,
  "enabledPlugins": {
    "vercel@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "outputStyle": "Concise",
  "syntaxHighlightingDisabled": false,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "advisorModel": "opus",
  "askUserQuestionTimeout": "never",
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-or-agents-md"
      }
    }
  },
  "autoUpdatesChannel": "stable",
  "minimumVersion": "2.1.209",
  "tui": "default",
  "timeFormat": "12-hour",
  "theme": "auto",
  "editorMode": "normal",
  "verbose": false,
  "preferredNotifChannel": "ghostty",
  "autoCompactEnabled": false,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": false,
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": false,
  "useAutoModeDuringPlan": true,
  "attribution": {
    "commit": "",
    "pr": ""
  }
}
