#!/bin/bash
# Browser design candidate. Activate only after the sandbox rounds are approved.
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"
BAR_NAME="${BAR_NAME:-sketchybar}"
PLUGIN_DIR="$CONFIG_DIR/plugins"

##### Bar Appearance #####
# Configuring the general appearance of the bar.
# These are only some of the options available. For all options see:
# https://felixkratz.github.io/SketchyBar/config/bar
# If you are looking for other colors, see the color picker:
# https://felixkratz.github.io/SketchyBar/config/tricks#color-picker

# Round 5: selected Dracula Glass with IBM Plex Mono Medium.
"$BAR_NAME" --bar position=top height=38 blur_radius=30 color=0x00000000 \
                margin=10 y_offset=8 padding_left=4 padding_right=4

##### Changing Defaults #####
# We now change some default values, which are applied to all further items.
# For a full list of all available item properties see:
# https://felixkratz.github.io/SketchyBar/config/items

default=(
  padding_left=5
  padding_right=5
  icon.font="IBM Plex Mono:Medium:14.0"
  label.font="IBM Plex Mono:Medium:14.0"
  icon.color=0xfff8f8f2
  label.color=0xfff8f8f2
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)
"$BAR_NAME" --default "${default[@]}"

space=(
  icon.padding_left=7
  icon.padding_right=7
  icon.highlight_color=0xffbd93f9
  background.color=0x29bd93f9
  background.corner_radius=5
  background.height=25
  background.drawing=off
  label.drawing=off
)
group=(
  background.color=0x99282a36
  background.border_color=0x1fffffff
  background.border_width=1
  background.corner_radius=8
  background.height=30
  background.drawing=on
)

# Reconcile the current AeroSpace list. Polling catches creation and deletion.
"$BAR_NAME" --add event aerospace_workspace_change \
           --add item workspace_template left \
           --set workspace_template "${space[@]}" drawing=off \
           --add item workspaces left \
           --set workspaces drawing=off updates=on update_freq=2 \
             script="\"$PLUGIN_DIR/workspaces.sh\" ${group[*]}" \
           --subscribe workspaces aerospace_workspace_change front_app_switched display_change system_woke

##### Adding Left Items #####
# We add some regular items to the left side of the bar, where
# only the properties deviating from the current defaults need to be set

"$BAR_NAME" --add item front_app left \
           --set front_app icon.drawing=off script="$PLUGIN_DIR/front_app.sh" \
           --subscribe front_app front_app_switched

##### Adding Right Items #####
# In the same way as the left items we can add items to the right side.
# Additional position (e.g. center) are available, see:
# https://felixkratz.github.io/SketchyBar/config/items#adding-items-to-sketchybar

# Right items grow leftward, so Focus appears before the clock.
"$BAR_NAME" --add event focus_changed \
           --add item clock right \
           --set clock update_freq=10 icon.drawing=off script="$PLUGIN_DIR/clock.sh" \
           --subscribe clock system_woke \
           --add item focus right \
           --set focus label.drawing=off width=24 background.color=0x00000000 \
             background.image.scale=0.5 update_freq=0 updates=on \
             script="$PLUGIN_DIR/focus.sh" \
           --subscribe focus focus_changed system_woke

##### Group Backgrounds #####
# Brackets draw a shared background behind the existing items.
# These settings are a design candidate. The browser sandbox does not run them.
"$BAR_NAME" --add bracket application front_app \
           --set application "${group[@]}" \
           --add bracket status focus clock \
           --set status "${group[@]}"

##### Force all scripts to run the first time (never do this in a script) #####
"$BAR_NAME" --update
